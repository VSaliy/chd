<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT10S" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <Period id="0" duration="PT10S">
    <AdaptationSet id="1" contentType="video" mimeType="video/mp4" segmentAlignment="true">
      <SegmentTemplate timescale="1000" initialization="video_$RepresentationID$_init.mp4?tempToken=abc&amp;x=1" media="video_$RepresentationID$_$Time$.m4s?tempToken=abc&amp;x=1">
        <SegmentTimeline>
          <S t="0" d="4000" r="1"/>
          <S d="2000"/>
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="v1080" codecs="avc1.640028" width="1920" height="1080" bandwidth="4000000"/>
      <Representation id="v720" codecs="avc1.4d401f" width="1280" height="720" bandwidth="2000000"/>
      <Representation id="v360" codecs="avc1.42c01e" width="640" height="360" bandwidth="600000"/>
    </AdaptationSet>
    <AdaptationSet id="2" contentType="audio" mimeType="audio/mp4" lang="en">
      <SegmentTemplate timescale="48000" duration="240000" startNumber="1" initialization="audio_init.mp4" media="audio_$Number%05d$.m4s"/>
      <Representation id="a1" codecs="mp4a.40.2" bandwidth="128000"/>
    </AdaptationSet>
  </Period>
</MPD>
